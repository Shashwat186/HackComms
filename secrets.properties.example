# Copy this file to secrets.properties (same folder, gitignored) and fill in your values.

# From the Nexconn Console -> your app -> App Key / App Secret
hackcomms.nexconn.app-key=
hackcomms.nexconn.app-secret=

# Data center your Nexconn app lives in. Singapore is the default:
#   SG: https://api.sg-light-api.com   NA: https://api.us-light-api.com
hackcomms.nexconn.api-base=https://api.sg-light-api.com
hackcomms.nexconn.area-code=SG

# Optional: send real OTP emails (Gmail needs an App Password)
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=you@gmail.com
# spring.mail.password=xxxx xxxx xxxx xxxx
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
